{
  "name": "micro:bit Development Environment",
  "description": "Complete development setup for Python, TypeScript, and MakeCode implementations",
  
  "image": "mcr.microsoft.com/devcontainers/base:jammy",
  
  "features": {
    "ghcr.io/devcontainers/features/node:latest": {
      "version": "22",
      "nodeGypDependencies": true
    },
    "ghcr.io/devcontainers/features/python:latest": {
      "version": "3.11"
    },
    "ghcr.io/devcontainers/features/git:latest": {}
  },
  
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "ms-vscode.makecode",
        "github.copilot"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python3",
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": false,
        "python.linting.flake8Enabled": true,
        "python.formatting.provider": "black",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter"
        },
        "files.exclude": {
          "**/__pycache__": true,
          "**/*.pyc": true,
          ".pytest_cache": true,
          "node_modules": true,
          "dist": true,
          ".venv": true
        }
      }
    }
  },
  
  "forwardPorts": [3000, 8080],
  "forwardPortsLocalhost": true,
  
  "postCreateCommand": "bash .devcontainer/setup-dev.sh",
  "postStartCommand": "echo '✅ Environment ready! Run: npm run test:all'",
  
  "mounts": [
    "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,consistency=cached"
  ],
  
  "remoteUser": "vscode",
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin"
  }
}
