#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🔍 Git commit 前の構文チェック..."

ROOT_DIR="$(pwd)"

# sample-compass (Python) の変更をチェック
if git diff --cached --name-only | grep -q "^projects/sample-compass/"; then
  echo "📝 sample-compass のファイルが変更されています"
  cd "$ROOT_DIR/projects/sample-compass"
  
  echo "✓ Python 構文チェック中..."
  if uv run python -m py_compile src/compass_makecode.py; then
    echo "✅ Python 構文チェック成功！"
  else
    echo "❌ Python 構文チェック失敗！commit をキャンセルしました。"
    exit 1
  fi
else
  echo "ℹ️ sample-compass に変更がありません"
fi

# sample-compass-ts (TypeScript) の変更をチェック
if git diff --cached --name-only | grep -q "^projects/sample-compass-ts/"; then
  echo "📝 sample-compass-ts のファイルが変更されています"
  cd "$ROOT_DIR/projects/sample-compass-ts"
  
  echo "✓ TypeScript コンパイルチェック中..."
  if ! npm run build; then
    echo "❌ TypeScript コンパイル失敗！commit をキャンセルしました。"
    exit 1
  fi
  echo "✅ TypeScript コンパイル成功！"
else
  echo "ℹ️ sample-compass-ts に変更がありません"
fi

# sample-compass-makecode の変更をチェック
if git diff --cached --name-only | grep -q "^projects/sample-compass-makecode/"; then
  echo "📝 sample-compass-makecode のファイルが変更されています"
  cd "$ROOT_DIR/projects/sample-compass-makecode"
  
  echo "✓ MakeCode 構文チェック中..."
  if ! npm run build; then
    echo "❌ MakeCode ビルド失敗！commit をキャンセルしました。"
    exit 1
  fi
  echo "✅ MakeCode ビルド成功！"
else
  echo "ℹ️ sample-compass-makecode に変更がありません"
fi

cd "$ROOT_DIR"
echo "✅ Pre-commit チェック完了！（テストは pre-push で実行します）"
