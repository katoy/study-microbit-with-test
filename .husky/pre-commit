#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🔍 Git commit 前の lint & テストチェック..."

# sample-compass (Python) の変更をチェック
if git diff --cached --name-only | grep -q "^sample-compass/"; then
  echo "📝 sample-compass のファイルが変更されています"
  cd sample-compass
  
  echo "🔨 Python コンパイルチェックを実行中..."
  if uv run python -m py_compile src/compass_makecode.py; then
    echo "✅ Python コンパイル成功！"
  else
    echo "❌ Python コンパイル失敗！commit をキャンセルしました。"
    exit 1
  fi
  cd ..
else
  echo "ℹ️ sample-compass に変更がありません"
fi

# sample-compass-ts (TypeScript) の変更をチェック
if git diff --cached --name-only | grep -q "^sample-compass-ts/"; then
  echo "📝 sample-compass-ts のファイルが変更されています"
  cd sample-compass-ts
  
  echo "🔨 TypeScript テストを実行中..."
  if npm test -- --runInBand; then
    echo "✅ TypeScript テスト成功！"
  else
    echo "❌ TypeScript テスト失敗！commit をキャンセルしました。"
    exit 1
  fi
  cd ..
else
  echo "ℹ️ sample-compass-ts に変更がありません"
fi

# sample-compass-makecode の変更をチェック
if git diff --cached --name-only | grep -q "^sample-compass-makecode/"; then
  echo "📝 sample-compass-makecode のファイルが変更されています"
  cd sample-compass-makecode
  
  echo "🔨 MakeCode コンパイル・シミュレーターテストを実行中..."
  if npm test; then
    echo "✅ MakeCode テスト成功！"
  else
    echo "❌ MakeCode テスト失敗！commit をキャンセルしました。"
    exit 1
  fi
  cd ..
else
  echo "ℹ️ sample-compass-makecode に変更がありません"
fi

echo "✅ Pre-commit チェック完了！"
