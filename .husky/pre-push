#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🚀 Git push 前のテスト実行..."

ZERO_SHA="0000000000000000000000000000000000000000"
FAILED_REFS=""
FAILED_PROJECTS=""
REPO_ROOT="$(git rev-parse --show-toplevel)"

while read -r local_ref local_sha remote_ref remote_sha; do
  # ブランチ削除ではテスト対象のファイルはありません。
  if [ "$local_sha" = "$ZERO_SHA" ]; then
    continue
  fi

  echo ""
  echo "📍 処理中: $local_ref"

  if [ "$remote_sha" = "$ZERO_SHA" ]; then
    # 新規refは比較元がないため、安全側に倒して送信ツリー全体を対象にします。
    if ! ref_files=$(git ls-tree -r --name-only "$local_sha"); then
      echo "❌ Push対象ファイルを取得できませんでした（ref: $local_ref）"
      FAILED_REFS="${FAILED_REFS} $local_ref"
      continue
    fi
  else
    if ! ref_files=$(git diff --name-only "$remote_sha" "$local_sha"); then
      echo "❌ Push差分を取得できませんでした（ref: $local_ref）"
      FAILED_REFS="${FAILED_REFS} $local_ref"
      continue
    fi
  fi

  # sample-compass (Python) のテスト
  if printf '%s\n' "$ref_files" | grep -q "^projects/sample-compass/"; then
    echo "📦 sample-compass のファイルが変更されています"
    cd "$REPO_ROOT/projects/sample-compass" || exit 1
    
    echo "🧪 Python コンパイルチェックを実行中..."
    if ! uv run python -m py_compile src/compass_makecode.py; then
      echo "❌ Python コンパイル失敗（ref: $local_ref）"
      FAILED_REFS="${FAILED_REFS} $local_ref"
      FAILED_PROJECTS="${FAILED_PROJECTS} sample-compass"
      cd "$REPO_ROOT" || exit 1
      continue
    fi
    echo "✅ Python コンパイルチェック 完了！"
    
    cd "$REPO_ROOT" || exit 1
  fi

  # sample-compass-ts (TypeScript) のテスト
  if printf '%s\n' "$ref_files" | grep -q "^projects/sample-compass-ts/"; then
    echo "📦 sample-compass-ts のファイルが変更されています"
    cd "$REPO_ROOT/projects/sample-compass-ts" || exit 1
    
    echo "🔨 ステップ 1/2: TypeScript ビルド..."
    if ! npm run build; then
      echo "❌ TypeScript ビルド失敗（ref: $local_ref）"
      FAILED_REFS="${FAILED_REFS} $local_ref"
      FAILED_PROJECTS="${FAILED_PROJECTS} sample-compass-ts"
      cd "$REPO_ROOT" || exit 1
      continue
    fi
    echo "✅ Build 完了！"
    
    echo "🧪 ステップ 2/2: TypeScript ユニット & 統合テスト実行..."
    if ! npm test; then
      echo "❌ TypeScript テスト失敗（ref: $local_ref）"
      FAILED_REFS="${FAILED_REFS} $local_ref"
      FAILED_PROJECTS="${FAILED_PROJECTS} sample-compass-ts"
      cd "$REPO_ROOT" || exit 1
      continue
    fi
    echo "✅ TypeScript テスト 完了！"
    
    cd "$REPO_ROOT" || exit 1
  fi

  # sample-compass-makecode のテスト
  if printf '%s\n' "$ref_files" | grep -q "^projects/sample-compass-makecode/"; then
    echo "📦 sample-compass-makecode のファイルが変更されています"
    cd "$REPO_ROOT/projects/sample-compass-makecode" || exit 1
    
    # 1. Build
    echo "🔨 ステップ 1/2: MakeCode ビルド..."
    if ! npm run build; then
      echo "❌ MakeCode ビルド失敗（ref: $local_ref）"
      FAILED_REFS="${FAILED_REFS} $local_ref"
      FAILED_PROJECTS="${FAILED_PROJECTS} sample-compass-makecode"
      cd "$REPO_ROOT" || exit 1
      continue
    fi
    echo "✅ Build 完了！"
    
    # 2. コンパイル・シミュレーターテスト
    echo "🧪 ステップ 2/2: MakeCode テスト実行..."
    if ! npm test; then
      echo "❌ MakeCode テスト失敗（ref: $local_ref）"
      FAILED_REFS="${FAILED_REFS} $local_ref"
      FAILED_PROJECTS="${FAILED_PROJECTS} sample-compass-makecode"
      cd "$REPO_ROOT" || exit 1
      continue
    fi
    echo "✅ MakeCode テスト 完了！"
    
    cd "$REPO_ROOT" || exit 1
  fi
done

echo ""

# 失敗したrefがある場合、詳細を表示して終了
if [ -n "$FAILED_REFS" ]; then
  echo "❌ テスト失敗のため Push をキャンセルしました"
  echo ""
  echo "📋 失敗した ref:"
  for ref in $FAILED_REFS; do
    echo "   - $ref"
  done
  echo ""
  echo "📋 失敗したプロジェクト:"
  for project in $FAILED_PROJECTS; do
    echo "   - $project"
  done
  echo ""
  echo "💡 対応方法:"
  echo "   1. 上記のプロジェクトでテストを修正してください"
  echo "   2. コミットして再度プッシュしてください"
  exit 1
fi

echo "🎉 すべてのテストに成功しました！Push を続行します。"
