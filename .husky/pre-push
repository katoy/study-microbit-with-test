#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🚀 Git push 前のテスト実行..."

ZERO_SHA="0000000000000000000000000000000000000000"
CHANGED_FILES=""

while read -r local_ref local_sha remote_ref remote_sha; do
  # ブランチ削除ではテスト対象のファイルはありません。
  if [ "$local_sha" = "$ZERO_SHA" ]; then
    continue
  fi

  if [ "$remote_sha" = "$ZERO_SHA" ]; then
    # 新規refは比較元がないため、安全側に倒して送信ツリー全体を対象にします。
    if ! ref_files=$(git ls-tree -r --name-only "$local_sha"); then
      echo "❌ Push対象ファイルを取得できませんでした。"
      exit 1
    fi
  else
    if ! ref_files=$(git diff --name-only "$remote_sha" "$local_sha"); then
      echo "❌ Push差分を取得できませんでした。"
      exit 1
    fi
  fi

  CHANGED_FILES="${CHANGED_FILES}
${ref_files}"
done

# sample-compass (Python) のテスト
if printf '%s\n' "$CHANGED_FILES" | grep -q "^sample-compass/"; then
  echo "📦 sample-compass のファイルが変更されています"
  cd sample-compass
  
  echo ""
  echo "🧪 Python ユニットテスト実行..."
  if ! uv run pytest test_compass.py test_build_hex.py -v; then
    echo "❌ Python ユニットテスト失敗！push をキャンセルしました。"
    exit 1
  fi
  echo "✅ Python ユニットテスト 完了！"
  
  echo ""
  echo "🔗 Python 統合テスト実行..."
  if ! uv run pytest test_compass_integration.py -v; then
    echo "❌ Python 統合テスト失敗！push をキャンセルしました。"
    exit 1
  fi
  echo "✅ Python 統合テスト 完了！"
  
  cd ..
else
  echo "ℹ️ sample-compass に変更がありません"
fi

# sample-compass-ts (TypeScript) のテスト
if printf '%s\n' "$CHANGED_FILES" | grep -q "^sample-compass-ts/"; then
  echo "📦 sample-compass-ts のファイルが変更されています"
  cd sample-compass-ts
  
  echo ""
  echo "🧪 TypeScript ユニット & 統合テスト実行..."
  if ! npm test; then
    echo "❌ TypeScript テスト失敗！push をキャンセルしました。"
    exit 1
  fi
  echo "✅ TypeScript テスト 完了！"
  
  cd ..
else
  echo "ℹ️ sample-compass-ts に変更がありません"
fi

# sample-compass-makecode のテスト
if printf '%s\n' "$CHANGED_FILES" | grep -q "^sample-compass-makecode/"; then
  echo "📦 sample-compass-makecode のファイルが変更されています"
  cd sample-compass-makecode
  
  # 1. Build
  echo ""
  echo "🔨 ステップ 1/2: MakeCode ビルド..."
  if npm run build; then
    echo "✅ Build 完了！"
  else
    echo "❌ Lint 失敗！push をキャンセルしました。"
    exit 1
  fi
  
  # 2. コンパイル・シミュレーターテスト
  echo ""
  echo "🧪 ステップ 2/2: MakeCode テスト実行..."
  if npm test; then
    echo "✅ MakeCode テスト 完了！"
  else
    echo "❌ ユニットテスト 失敗！push をキャンセルしました。"
    exit 1
  fi
  
  cd ../
else
  echo "ℹ️ sample-compass-makecode に変更がありません"
fi

echo ""
echo "🎉 すべてのテストに成功しました！Push を続行します。"
