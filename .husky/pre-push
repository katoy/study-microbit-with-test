#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🚀 Git push 前のテスト実行..."

# sample-compass (Python) のテスト
if git diff origin/$(git rev-parse --abbrev-ref HEAD)..HEAD --name-only 2>/dev/null | grep -q "sample-compass"; then
  echo "📦 sample-compass のファイルが変更されています"
  cd sample-compass
  
  echo ""
  echo "🧪 Python ユニットテスト実行..."
  if ! pytest test_compass.py -v; then
    echo "❌ Python ユニットテスト失敗！push をキャンセルしました。"
    exit 1
  fi
  echo "✅ Python ユニットテスト 完了！"
  
  echo ""
  echo "🌐 Python E2E テスト実行..."
  if ! pytest e2e_test_compass.py -v; then
    echo "❌ Python E2E テスト失敗！push をキャンセルしました。"
    exit 1
  fi
  echo "✅ Python E2E テスト 完了！"
  
  cd ..
else
  echo "ℹ️ sample-compass に変更がありません"
fi

# sample-compass-ts (TypeScript) のテスト
if git diff origin/$(git rev-parse --abbrev-ref HEAD)..HEAD --name-only 2>/dev/null | grep -q "sample-compass-ts"; then
  echo "📦 sample-compass-ts のファイルが変更されています"
  cd sample-compass-ts
  
  echo ""
  echo "🧪 TypeScript ユニット & E2E テスト実行..."
  if ! npm test; then
    echo "❌ TypeScript テスト失敗！push をキャンセルしました。"
    exit 1
  fi
  echo "✅ TypeScript テスト 完了！"
  
  cd ..
else
  echo "ℹ️ sample-compass-ts に変更がありません"
fi

# sample-compass-makecode のテスト
if git diff origin/$(git rev-parse --abbrev-ref HEAD)..HEAD --name-only 2>/dev/null | grep -q "sample-compass-makecode"; then
  echo "📦 sample-compass-makecode のファイルが変更されています"
  cd sample-compass-makecode
  
  # 1. Lint (Build)
  echo ""
  echo "🔨 ステップ 1/3: Lint チェック (pxt build)..."
  if pxt build --cloud; then
    echo "✅ Lint 完了！"
  else
    echo "❌ Lint 失敗！push をキャンセルしました。"
    exit 1
  fi
  
  # 2. ユニットテスト
  echo ""
  echo "🧪 ステップ 2/3: ユニットテスト実行 (pxt test)..."
  if pxt test; then
    echo "✅ ユニットテスト 完了！"
  else
    echo "❌ ユニットテスト 失敗！push をキャンセルしました。"
    exit 1
  fi
  
  # 3. E2E テスト
  echo ""
  echo "🌐 ステップ 3/3: E2E テスト実行..."
  if npm run e2e:advanced; then
    echo "✅ E2E テスト 完了！"
  else
    echo "⚠️ E2E テスト 失敗！push をキャンセルしました。"
    exit 1
  fi
  
  cd ../
else
  echo "ℹ️ sample-compass-makecode に変更がありません"
fi

echo ""
echo "🎉 すべてのテストに成功しました！Push を続行します。"
