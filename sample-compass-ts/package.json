{
  "name": "sample-compass-ts",
  "version": "1.0.0",
  "description": "micro:bit 用 TypeScript 方位磁石アプリケーション",
  "main": "dist/compass.js",
  "types": "dist/compass.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern='^(?!.*\\.integration\\.test\\.ts$).*\\.test\\.ts$'",
    "test:integration": "jest --testPathPattern='integration'",
    "lint": "eslint src test --max-warnings 0",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write src test",
    "clean": "rm -rf dist .pytest_cache .coverage htmlcov"
  },
  "keywords": [
    "microbit",
    "compass",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.3",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "@types/jest": "^29.5.8",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2"
  }
}
